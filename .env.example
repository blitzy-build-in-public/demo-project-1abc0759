# Environment variables for Task Tracker. Copy this file to .env and replace the placeholders.
# .env is gitignored and holds real secrets, so it is never committed; this file holds none.
# `npm run start:local` and `npm run migrate:local` load .env through Node's --env-file, and
# docker compose reads it to fill POSTGRES_PASSWORD and SESSION_SECRET.
# Keep every comment on a line of its own: a comment after a value is not supported.

# Required. PostgreSQL connection string for the application and the migration runner. It must
# start with postgres:// or postgresql://, and its password must equal POSTGRES_PASSWORD below.
# Integration and end-to-end tests ignore .env and read DATABASE_URL from the shell: export a
# URL whose database is tasktracker_test (the tests refuse a database not named *_test).
DATABASE_URL=postgres://tasktracker:change-me@localhost:5432/tasktracker

# Required, at least 32 characters. Keys the session-cookie signature and the CSRF tokens;
# changing it logs out every user. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional, default 3000. HTTP listen port, an integer from 1 to 65535.
PORT=3000

# Optional, default development. One of production, development or test. production adds the
# Secure attribute to the session and CSRF cookies; any other value stops start-up.
NODE_ENV=development

# Used only by docker-compose.yml, as the db service's password and inside the app service's
# DATABASE_URL; the application never reads it. Use URL-safe characters only (letters and
# digits), because compose places it unencoded inside a URL.
POSTGRES_PASSWORD=change-me
